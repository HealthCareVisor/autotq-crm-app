<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">
  <Id>92d46228-5e8f-4282-b1e7-aab7f3074417</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>Golden Hour Medical</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="AutoTQ"/>
  <Description DefaultValue="Send personal copies: the email you're writing goes to each person in To or Bcc as their own copy, from your mailbox, with {{name}} filled in."/>
  <IconUrl DefaultValue="https://autotqcrm.goldenhourmedical.com/outlook/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://autotqcrm.goldenhourmedical.com/outlook/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://autotqcrm.goldenhourmedical.com/"/>
  <AppDomains>
    <AppDomain>https://autotqcrm.goldenhourmedical.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://autotqcrm.goldenhourmedical.com/outlook/commands.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="CommandsUrl"/>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="autotqMergeGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="Button" id="autotqMergeButton">
                  <Label resid="ButtonLabel"/>
                  <Supertip>
                    <Title resid="ButtonLabel"/>
                    <Description resid="ButtonTip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16"/>
                    <bt:Image size="32" resid="Icon32"/>
                    <bt:Image size="80" resid="Icon80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>sendCopies</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://autotqcrm.goldenhourmedical.com/outlook/assets/icon-16.png"/>
        <bt:Image id="Icon32" DefaultValue="https://autotqcrm.goldenhourmedical.com/outlook/assets/icon-32.png"/>
        <bt:Image id="Icon80" DefaultValue="https://autotqcrm.goldenhourmedical.com/outlook/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="CommandsUrl" DefaultValue="https://autotqcrm.goldenhourmedical.com/outlook/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="AutoTQ"/>
        <bt:String id="ButtonLabel" DefaultValue="Send personal copies"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ButtonTip" DefaultValue="Each person in To, Cc or Bcc gets their own copy from your mailbox, with {{name}}, {{company}} and the rest filled in from the CRM."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
